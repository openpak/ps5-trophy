# HTTP listen address (plain HTTP; TLS terminates at Traefik).
PS5_ADDR=:8080
# HMAC key shared with ps5-auth for bearer tokens, at least 32 bytes. Required.
PS5_TOKEN_KEY=
# Optional. Directory of trophy-set *.json files (see sets/example.json).
# PS5_TROPHY_SETS_DIR=/sets
# Optional. Enables POST /internal/unlock (header X-OpenPak-Internal-Key). Unset: the endpoint answers 404.
# PS5_TROPHY_INTERNAL_KEY=

# Earned trophies live in the neutral achievements core (gRPC), not here. REQUIRED unless PS5_DEV_MEMORY=1.
# The key is the achievements core's internal key, at least 32 bytes (same value np-trophy uses as NP_ACHIEVEMENTS_KEY).
PS5_ACHIEVEMENTS_ADDR=openpak-achievements:20221
PS5_ACHIEVEMENTS_KEY=change-me-achievements-internal-key-32-bytes
# Local development only: keep earnings in memory (lost on restart).
# PS5_DEV_MEMORY=1
