# HTTP listen address (plain HTTP; TLS terminates at Traefik).
PS5_ADDR=:8080
# HMAC key shared with ps5-auth for bearer tokens, at least 32 bytes. Required.
PS5_TOKEN_KEY=
# Optional. Directory of trophy-set *.json files (see sets/example.json).
# PS5_TROPHY_SETS_DIR=/sets
# Optional. Enables POST /internal/unlock (header X-OpenPak-Internal-Key). Unset: the endpoint answers 404.
# PS5_TROPHY_INTERNAL_KEY=
